# Backend Environment Configuration
APP_NAME=智能菜谱推荐系统
DEBUG=true

# SQL 日志开关（与 DEBUG 解耦，默认关闭；排查 SQL 时临时设 true）
SQL_ECHO=false

# MySQL
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=123456
DB_NAME=recipe_system
DB_CHARSET=utf8mb4

# JWT —— 生产环境必须替换为强随机字符串（建议至少 32 字节）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-STRONG-RANDOM-SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 跨域白名单
# 开发环境：* （允许所有来源，allow_credentials 自动设为 False）
# 生产环境：必须配置具体域名，逗号分隔，例如：
#   CORS_ALLOW_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOW_ORIGINS=*

# 菜谱封面图白名单域名（仅允许专业美食网站，逗号分隔）
# 符合项目硬约束：避免瓷器、文档、风景等不相关图片
RECIPE_COVER_WHITELIST=meishichina.com,xiachufang.com,douguo.com,xiangha.com

# Chroma 向量数据库
# ⚠ 注意：ChromaDB 1.5.9 Rust 绑定不支持中文路径，
#   此路径必须是不含中文字符的绝对路径，如 F:/chroma_db
CHROMA_PERSIST_DIR=F:/chroma_db

# Embedding（SiliconFlow BGE-M3）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=YOUR_API_KEY
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings

# LLM（默认小米 Mimo mimo-v2.5，关闭深度思考只输出最终答案）
LLM_PROVIDER=mimo
LLM_MODEL=mimo-v2.5
LLM_API_KEY=YOUR_MIMO_API_KEY
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# 关闭模型思考模式（MiMo mimo-v2.5 默认开启深度思考，设 true 关闭）
LLM_DISABLE_THINKING=true

# RAG 参数
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
# 对话 RAG 候选池：召回候选数 + 最终喂给模型的去重菜谱上限
RAG_CHAT_RECALL_K=40
RAG_CHAT_MAX_DISHES=12
RAG_EMBEDDING_BATCH_SIZE=64
RAG_CHECKPOINT_FILE=./chroma_db/rebuild_checkpoint.json

# Rerank 精排（两阶段检索第二级，失败/超时自动降级为召回排序）
# RERANK_API_KEY 留空时自动复用 EMBEDDING_API_KEY（同为 SiliconFlow）
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=
RERANK_TIMEOUT=10
RERANK_MAX_CANDIDATES=32
# 分数融合权重：0=纯召回序，1=纯精排序，0.5=精排微调（推荐，避免推翻粗排好序）
RERANK_ALPHA=0.5
